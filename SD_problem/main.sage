from sage.all_cmdline import *   # import sage library

_sage_const_1 = Integer(1)
import random

# https://veron.univ-tln.fr/M2/sd/
# Pour vérifier les programmes

"""
Fonction qui génère une matrice de taille n * k à partir de H
H : matrice de taille n * k
n : entier, nombre de colonnes
k : entier, nmobre de ligne
"""
def gen_M(H, n, k):
    # On permute aléatoirement une liste de n nombres
    p = list(range(n))
    random.shuffle(p)

    # On garde seulement les (n - k) premières colonnes
    H_perm = H.matrix_from_columns(p)
    limite = n - k
    M = H_perm[:, :limite]

    return M, p

"""
Fonction qui ajoute s à droite de M
M : matrice taille (n - k) * (n - k)
s : vecteur de taille (n - k)
"""
def echelon_M_S(M, s):
    # On vérifie si M inversible
    if(not M.is_invertible()):
        print("La matrice M n'est pas inversible")
        return None

    # On ajoute le syndrome comme la colonne de droite M | s
    S = vector(GF(2), s)  
    M_S = M.augment(S.column())

    # Réduction gaussienne
    M_S = M_S.echelon_form()

    return M_S

"""
Fonction qui réitère l'expérience jusqu'à ce que M soit inversible
H : matrice, taille (n - k) * n
n : entier
k : entier
s : liste
"""
def verif_M_S(H, n, k, s):
    # On récupère M | S
    M, p = gen_M(H, n, k)
    M_S = echelon_M_S(M, s)

    # On teste jusqu'à ce qu'on tombe sur un M inversible
    while(M_S == None):
        M, p = gen_M(H, n, k)
        M_S = echelon_M_S(M, s)
    
    return M_S, p

"""
Fonction qui caclcule le poids d'un vecteur
s : liste, le syndrome
"""
def poids_hamming(s):
    return s.hamming_weight()

"""
Fonction qui réitère l'expérience tant que le poids Hamming de s <= t et renvoie e = s * p
H : matrice n * k
n : entier, ligne de la matrice
k : entier, colonne de la matrice
s : vecteur, syndrome
t : entier, nombre limite d'erreur
"""

def SD_problem(H, n, k, s, t):
    s_original = vector(GF(2), s)

    # On tire un M_S valide
    M_S, p = verif_M_S(H, n, k, s_original)

    # On récupère le syndrome transformé
    s_tilde = M_S.column(n - k)

    while poids_hamming(s_tilde) > t:
        M_S, p = verif_M_S(H, n, k, s_original)
        s_tilde = M_S.column(n - k)

    # Vecteur erreur entier
    e_perm = vector(GF(2), list(s_tilde) + [0] * k)

    # On remet les coordonnées dans l'ordre original
    e = vector(GF(2), n)
    for i in range(n):
        e[p[i]] = e_perm[i]

    # Vérification finale
    if H * e == s_original and poids_hamming(e) <= t:
        return e

